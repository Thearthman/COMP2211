watch_file pyproject.toml uv.lock flake.nix flake.lock

if [[ -d /nix/store ]]; then
  # NixOS and regular Nix installations expose /nix/store directly.
  use flake
else
  # nix-portable virtualizes /nix/store inside bubblewrap, so store paths cannot
  # be exported into the host shell. Expose the flake tools through thin shims.
  shim_dir="$PWD/.direnv/nix-portable/bin"
  mkdir -p "$shim_dir"

  for command in \
    python python3 python3.13 \
    f2py fonttools numpy-config pyftmerge pyftsubset ttx \
    uv watchexec basedpyright basedpyright-langserver
  do
    cat > "$shim_dir/$command" <<EOF
#!/usr/bin/env bash
set -euo pipefail
# The shim also runs inside the nix-portable mount namespace (for example,
# when basedpyright invokes its configured Python interpreter). There the
# real dev-shell command is already on PATH; nesting another nix-portable
# runtime would fail because the kernel does not allow the inner bwrap to
# create a user namespace.
if [[ -d /nix/store ]]; then
  # PATH is the dev shell's PATH here, with the real command ahead of this shim.
  exec "$command" "\$@"
fi
exec nix --option warn-dirty false develop --command "$command" "\$@"
EOF
    chmod +x "$shim_dir/$command"
  done

  PATH_add "$shim_dir"
  export REPO_ROOT="$PWD"

  # Enter the dev shell once so its shellHook can start the Python watcher in
  # the nix-portable mount namespace. The watcher must stay there to see
  # /nix/store; only interactive terminals need it.
  if [[ -t 0 || -t 1 || -t 2 ]]; then
    nix --option warn-dirty false develop --command true
  fi
fi
